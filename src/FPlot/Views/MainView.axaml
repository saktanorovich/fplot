<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FPlot.ViewModels"
             xmlns:views="clr-namespace:FPlot.Views"
             mc:Ignorable="d"
             x:Class="FPlot.Views.MainView"
             x:DataType="viewModels:MainViewModel">
    <!-- <Grid Margin="4" RowDefinitions="*,Auto"> -->
    <!--     <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*"> -->
    <!--         <Grid Grid.Column="0"> -->
    <!--             <Grid RowDefinitions="Auto,*"> -->
    <!--                 <views:MenuView Grid.Row="0" x:Name="MenuView" DataContext="{Binding}"/> -->
    <!--                 <views:GridView Grid.Row="1" x:Name="GridView" DataContext="{Binding Grid}"/> -->
    <!--             </Grid> -->
    <!--         </Grid> -->
    <!--         <Grid Column="1" Width="20" /> -->
    <!--         <Grid Grid.Column="2"> -->
    <!--             <views:PlotView x:Name="PlotView" DataContext="{Binding Plot}"/> -->
    <!--         </Grid> -->
    <!--     </Grid> -->
    <!--     <StackPanel Grid.Row="1"> -->
    <!--         <TextBlock Text="{Binding SelectedPath}" IsEnabled="False"></TextBlock> -->
    <!--     </StackPanel> -->
    <!-- </Grid> -->
   <Grid Margin="4" RowDefinitions="Auto,*,Auto">
        <!-- Menu -->
        <views:MenuView x:Name="MenuView"
                      Grid.Row="0"
                      Margin="4"
                      DataContext="{Binding}"/>
        <!-- View -->
        <Border Grid.Row="1"
                Margin="6"
                CornerRadius="2">
            <Grid ColumnDefinitions="300,2,*">
                <views:GridView x:Name="GridView"
                                Grid.Column="0"
                                DataContext="{Binding Path=Grid}"/>

                <GridSplitter Grid.Column="1"
                              Background="#E0E0E0"
                              MinWidth="0"
                              ResizeDirection="Columns"/>

                <views:PlotView x:Name="PlotView"
                                Grid.Column="2"
                                DataContext="{Binding Path=Plot}"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="6">
          <TextBlock Text="{Binding Path=SelectedPath}" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</UserControl>
