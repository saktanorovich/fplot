    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Path">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition
                        Property="RenderTransform"
                        Duration="0:0:0.40"
                        Easing="CircularEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.5)"/>
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Border ToolTip.Tip="Add point">
                <Path Data="{DynamicResource AddPointResx}"/>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PointerPressed">
                        <InvokeCommandAction Command="{Binding AddPointCommand}"/>
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </Border>
            <Border ToolTip.Tip="Remove point (unavailable)">
                <Path Data="{DynamicResource RemovePointResx}"/>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PointerPressed">
                        <InvokeCommandAction Command="{Binding RemovePointCommand}"/>
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Border ToolTip.Tip="Copy points">
                <Path Data="{DynamicResource CopyPointsResx}"/>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PointerPressed">
                        <InvokeCommandAction Command="{Binding CopyCommand}"></InvokeCommandAction>
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </Border>
            <Border ToolTip.Tip="Paste points">
                <Path Data="{DynamicResource PastePointsResx}"/>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PointerPressed">
                        <InvokeCommandAction Command="{Binding PasteCommand}"></InvokeCommandAction>
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
