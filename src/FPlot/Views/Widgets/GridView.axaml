<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:FPlot.ViewModels"
             xmlns:converters="using:FPlot.Converters"
             mc:Ignorable="d"
             x:Class="FPlot.Views.GridView"
             x:DataType="viewModels:GridViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox.default">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Section header -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
    </UserControl.Styles>
    <Grid>
        <Border Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Classes="section"
                           Text="CONTROL POINTS"/>

                <!-- Column headers (manual, since DataGrid headers can be styled complex) -->
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="*,*"
                      Margin="0,0,0,2">
                    <Border Grid.Column="0"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="4">
                        <TextBlock Text="X"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#555"/>
                    </Border>
                    <Border Grid.Column="1"
                            Background="Transparent"
                            CornerRadius="0,4,4,0"
                            Padding="8,4">
                      <TextBlock Text="Y = f(X)"
                                 FontWeight="SemiBold"
                                 FontSize="12"
                                 Foreground="#555"/>
                    </Border>
                </Grid>

                <!-- Data grid -->
                <DataGrid x:Name="GridControl"
                          ItemsSource="{Binding Points}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          GridLinesVisibility="All"
                          CanUserSortColumns="False"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          BorderBrush="LightGray"
                          BorderThickness="1"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          HeadersVisibility="None"
                          Background="White"
                          CornerRadius="4"
                          FontSize="12"
                          ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <DataGrid.Styles>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="DataGridRow">
                            <Setter Property="Height" Value="20"></Setter>
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <!-- <DataGridTemplateColumn.HeaderTemplate> -->
                            <!--     <DataTemplate> -->
                            <!--         <StackPanel Orientation="Horizontal"> -->
                            <!--             <TextBlock Text="X Value" FontSize="14" FontWeight="Bold"/> -->
                            <!--         </StackPanel> -->
                            <!--     </DataTemplate> -->
                            <!-- </DataGridTemplateColumn.HeaderTemplate> -->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBox Classes="default"
                                                 Text="{Binding Path=X, Converter={converters:DoubleToStringConverter}}"
                                                 Foreground="{Binding XChanged, Converter={converters:ChangedToBrushConverter}}">
                                        </TextBox>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <!-- <DataGridTemplateColumn.HeaderTemplate> -->
                            <!--     <DataTemplate> -->
                            <!--         <StackPanel Orientation="Horizontal"> -->
                            <!--             <TextBlock Text="Y Value" FontSize="14" FontWeight="Bold"/> -->
                            <!--         </StackPanel> -->
                            <!--     </DataTemplate> -->
                            <!-- </DataGridTemplateColumn.HeaderTemplate> -->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBox Classes="default"
                                                 Text="{Binding Path=Y, Converter={converters:DoubleToStringConverter}}"
                                                 Foreground="{Binding YChanged, Converter={converters:ChangedToBrushConverter}}"
                                                 IsReadOnly="False">
                                        </TextBox>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
</UserControl>
